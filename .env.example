# SHA-256 hex digest(s) of allowed RiseUp PATs, comma-separated.
# printf %s 'riseup_pat_...' | sha256sum
ALLOWED_PAT_SHA256=

# OAuth mode (recommended): token goes in a header, never in a URL.
# Public base URL of this server, e.g. https://rs-7k2q.example.com (no trailing path)
PUBLIC_URL=
# 32 random bytes as hex: openssl rand -hex 32
# Changing it signs out every connected Claude session.
TOKEN_ENCRYPTION_KEY=

# Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels)
TUNNEL_TOKEN=
